---
import logo from "../assets/logo-mark-white.webp";

const year = new Date().getFullYear();
---

<footer class="wash-deep">
  <div class="mx-auto max-w-7xl px-5 sm:px-8 py-16 grid gap-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3">
        <img src={logo.src} alt="" width="56" height="56" class="h-14 w-14" />
        <div>
          <p class="font-script text-3xl text-white leading-none">The Little Mint</p>
          <p class="text-[0.7rem] tracking-[0.25em] uppercase text-cream-100/80 mt-1">Mortgage Company</p>
        </div>
      </div>
      <p class="mt-5 max-w-md text-cream-100/80 leading-relaxed">
        Independent, whole-of-market mortgage advice from Sarah — fee-free, by appointment, helping buyers across England, Wales, Scotland and Northern Ireland.
      </p>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-[0.2em] text-mint-300 font-semibold">Visit</h3>
      <ul class="mt-4 space-y-2 text-sm text-cream-100/85">
        <li><a href="/#home" class="hover:text-white">Home</a></li>
        <li><a href="/#about" class="hover:text-white">About</a></li>
        <li><a href="/#services" class="hover:text-white">Services</a></li>
        <li><a href="/#faq" class="hover:text-white">FAQ</a></li>
        <li><a href="/#contact" class="hover:text-white">Contact</a></li>
      </ul>
    </div>

    <div>
      <h3 class="text-xs uppercase tracking-[0.2em] text-mint-300 font-semibold">Get in touch</h3>
      <ul class="mt-4 space-y-2 text-sm text-cream-100/85">
        <li><a href="mailto:sarah@thelittlemintmortgagecompany.com" class="hover:text-white break-all">sarah@thelittlemintmortgagecompany.com</a></li>
        <li><a href="tel:+447793204066" class="hover:text-white">07793 204066</a></li>
        <li><a href="https://www.facebook.com/profile.php?id=61591207851140" class="hover:text-white inline-flex items-center gap-1.5" target="_blank" rel="noopener noreferrer">Facebook <svg class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/><path d="M5 5a2 2 0 00-2 2v8a2 2 0 002 2h8a2 2 0 002-2v-3a1 1 0 10-2 0v3H5V7h3a1 1 0 000-2H5z"/></svg></a></li>
        <li class="text-cream-100/60">Office 12, 13-15 Preston Street, Fleetwood, FY7 6JA</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 py-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-cream-100/60">
      <p>© {year} The Little Mint Mortgage Company. All rights reserved.</p>
      <p>
        Your home may be repossessed if you do not keep up repayments on a mortgage.
        Most buy-to-let mortgages are not regulated by the Financial Conduct Authority.
      </p>
    </div>
  </div>
</footer>
