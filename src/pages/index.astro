---
import BaseLayout from "../layouts/BaseLayout.astro";
import sarah from "../assets/sarah.webp";
import logo from "../assets/logo-mark.webp";

const serviceDetails = [
  {
    title: "First-time buyer mortgages",
    summary: "Buying your first home is exciting, and a little terrifying. We hold the map.",
    points: [
      "Saving the deposit and how much you can really borrow",
      "Help to Buy (Equity Loan), Shared Ownership, and First Homes",
      "Finding a lender that says yes to your circumstances",
      "Agreement in Principle, then full application through to completion",
    ],
  },
  {
    title: "Home mover & purchase mortgages",
    summary: "Moving up, moving sideways, or buying your next home after a life change.",
    points: [
      "Porting your existing mortgage to avoid early repayment charges",
      "Borrowing more to fund a bigger property",
      "Coordinating chains, completion dates, and deposit timing",
      "Switching to a better deal when you don't need to remortgage yet",
    ],
  },
  {
    title: "Remortgaging",
    summary: "Move off your lender's standard variable rate, raise capital, or change the term.",
    points: [
      "Switching to a better deal at the end of a fixed rate",
      "Releasing equity for home improvements or life events",
      "Changing from interest-only to repayment (or vice versa)",
      "Product transfer vs full remortgage — when each makes sense",
    ],
  },
  {
    title: "Buy-to-let (single let)",
    summary: "Your first rental, or a single property that needs specialist mortgage advice.",
    points: [
      "Stress-tested affordability based on rental income",
      "Standard BTL rates across the whole of the market",
      "Holiday-let and serviced accommodation",
      "Deciding whether to hold personally or via limited company",
    ],
  },
  {
    title: "Portfolio buy-to-let",
    summary: "Multiple rental properties, one broker, one consistent strategy.",
    points: [
      "Lender portfolio limits (how many properties one lender will hold)",
      "Top slicing income across the portfolio for affordability",
      "Refinancing individual properties as the portfolio grows",
      "Stress-testing against interest rate rises and void periods",
    ],
  },
  {
    title: "Limited company buy-to-let",
    summary: "Holding rentals in a LtdCo for tax efficiency — with the lending to match.",
    points: [
      "Comparing LtdCo vs personal BTL rates",
      "Transferring existing properties into the company",
      "Directors' guarantees and security structures",
      "Tax-aware structuring alongside your accountant",
    ],
  },
  {
    title: "Self-employed & contractors",
    summary: "Sole traders, limited company directors, freelancers, and umbrella workers.",
    points: [
      "Using SA302s, company accounts, or day-rate contracts",
      "Dealing with lenders who specialise in non-PAYE income",
      "Maximising borrowing with the right accountant paperwork",
      "Bridging loans if you need speed",
    ],
  },
  {
    title: "Help to Buy & Shared Ownership",
    summary: "Government-backed schemes that can put a first home within reach — explained.",
    points: [
      "Help to Buy Equity Loan (where still available)",
      "Shared Ownership staircasing and resale",
      "First Homes and other local schemes",
      "Combining schemes with standard mortgages",
    ],
  },
  {
    title: "Equity release & later-life lending",
    summary: "Options for the over-55s, discussed carefully and only where appropriate.",
    points: [
      "Lifetime mortgages (roll-up interest)",
      "Retirement Interest-Only mortgages",
      "Voluntary surrender of existing schemes",
      "Inheritance and family implications",
    ],
  },
  {
    title: "Protection insurance",
    summary: "The cover that runs alongside your mortgage — so a worst-case event doesn't cost you your home.",
    points: [
      "Life cover — pays off the mortgage if the worst happens",
      "Critical illness cover — lump sum on diagnosis of a specified condition",
      "Income protection — replaces part of your income if you can't work",
      "Buildings and contents insurance — the basics, often bundled",
    ],
  },
];

const values = [
  { title: "Independent", body: "We're whole-of-market, not tied to any one lender. If a deal isn't right, we'll tell you — and we'll tell you why." },
  { title: "Plain English", body: "Mortgages come with their own language. We translate, we don't lecture. You'll leave every conversation knowing exactly where you stand." },
  { title: "Properly human", body: "You'll get a real person who picks up the phone, knows your file, and remembers why you called. No call centres, no scripts." },
  { title: "Lifelong", body: "Most of our clients come back for their next move. We measure success in second and third mortgages, not first." },
];
---

<BaseLayout
  title="The Little Mint Mortgage Company"
  description="Independent, fee-free mortgage advice from Sarah — a whole-of-market mortgage adviser in Fleetwood, serving first-time buyers, remortgages, buy-to-let, self-employed, Help to Buy and equity release across the UK. Every home has a story."
>
  <!-- ============ HERO ============ -->
  <section id="home" class="relative overflow-hidden wash-mint">
    <div class="mx-auto max-w-7xl px-5 sm:px-8 pt-16 pb-24 md:pt-24 md:pb-32 grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <p class="text-xs uppercase tracking-[0.3em] text-mint-700 font-semibold">Fleetwood mortgage adviser · whole of market</p>
        <h1 class="mt-4 font-sans text-5xl sm:text-6xl lg:text-7xl font-bold text-ink-900 leading-[1.05]">
          Independent mortgage advice, <br class="hidden sm:inline" />
          <span class="font-script text-mint-700 font-normal text-6xl sm:text-7xl lg:text-8xl">made human.</span>
        </h1>
        <p class="mt-6 text-lg sm:text-xl text-ink-700/80 max-w-xl leading-relaxed">
          Sarah is a whole-of-market mortgage adviser in Fleetwood offering fee-free advice on first-time buyer mortgages, remortgages, buy-to-let, self-employed, Help to Buy and equity release — for buyers across England, Wales, Scotland and Northern Ireland.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#contact" class="inline-flex items-center gap-2 bg-mint-700 hover:bg-mint-800 text-white text-base font-semibold px-7 py-3.5 rounded-full shadow-mint-glow transition">
            Book a free chat
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" /></svg>
          </a>
          <a href="#services" class="inline-flex items-center gap-2 bg-white/70 hover:bg-white text-ink-800 text-base font-semibold px-7 py-3.5 rounded-full border border-mint-200 transition">
            See what we do
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-800 font-medium">
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-mint-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            Whole of market
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-mint-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            FCA regulated
          </li>
          <li class="inline-flex items-center gap-1.5">
            <svg class="h-4 w-4 text-mint-700" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" /></svg>
            No upfront fees
          </li>
        </ul>
        <p class="mt-6 text-[0.7rem] text-ink-700/55 max-w-md leading-snug">
          Your home may be repossessed if you do not keep up repayments on a mortgage.
        </p>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="relative max-w-sm mx-auto">
          <div class="relative rounded-3xl overflow-hidden shadow-mint-glow ring-1 ring-mint-200">
            <img
              src={sarah.src}
              alt="Sarah Mullender, founder and CeMAP-qualified mortgage adviser at The Little Mint Mortgage Company"
              class="w-full h-auto object-cover aspect-[4/5]"
              width="640"
              height="800"
              fetchpriority="high"
              decoding="async"
            />

            <div class="absolute bottom-4 left-4 right-4 rounded-2xl bg-cream-50/95 backdrop-blur px-5 py-4 shadow-md">
<p class="text-base font-semibold text-ink-900">Sarah Mullender</p>
              <p class="text-xs text-mint-700 font-medium uppercase tracking-[0.15em]">CeMAP · Founder & mortgage adviser</p>
            </div>
          </div>
          <p class="mt-6 text-center font-script text-3xl text-mint-700">Every home has a story.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES (heading + cards) ============ -->
  <section id="services" class="section scroll-mt-20 bg-mint-50/50">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.3em] text-mint-700 font-semibold">What we do</p>
        <h2 class="mt-3 text-4xl sm:text-5xl font-bold text-ink-900 leading-tight">
          A mortgage for <span class="font-script text-mint-700 font-normal text-5xl sm:text-6xl">every chapter.</span>
        </h2>
        <p class="mt-5 text-lg text-ink-700/80 leading-relaxed">
          Whether it's your first flat, a forever home, a single rental or a growing portfolio — we search the whole market and explain the options in plain English. Plus the protection cover that keeps the roof over your head if life doesn't go to plan.
        </p>
      </div>

      <div class="mt-14 space-y-10">
        {serviceDetails.map((s, i) => (
          <article class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start p-8 sm:p-10 rounded-3xl border border-mint-100 bg-white">
          <div class="lg:col-span-4">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-mint-100 text-mint-700 font-bold text-sm">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="text-2xl sm:text-3xl font-semibold text-ink-900">{s.title}</h3>
            </div>
            <p class="mt-4 text-ink-700/80 leading-relaxed">{s.summary}</p>
          </div>
          <ul class="lg:col-span-8 space-y-3">
            {s.points.map((p) => (
              <li class="flex items-start gap-3 text-ink-800/90 leading-relaxed">
                <svg class="mt-1 h-5 w-5 flex-none text-mint-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                </svg>
                <span>{p}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
      </div>
    </div>
  </section>

  <!-- ============ PROCESS (dark band) ============ -->
  <section class="section wash-deep">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mint-300 font-semibold">How it works</p>
      <h2 class="mt-3 text-4xl sm:text-5xl font-bold text-cream-50 leading-tight max-w-3xl">
        A simple, four-step <span class="font-script text-mint-300 font-normal text-5xl sm:text-6xl">process.</span>
      </h2>
      <ol class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 items-stretch">
        {[
          { n: "01", t: "Quick chat", d: "Tell us where you are and where you'd like to be. 20 minutes, no obligation." },
          { n: "02", t: "Search", d: "We run the numbers across every relevant lender and come back with a shortlist — usually 2 or 3." },
          { n: "03", t: "Recommendation", d: "We explain the trade-offs in plain English, recommend what we'd pick, and only move when you're ready." },
          { n: "04", t: "To keys", d: "We handle the paperwork and chase the lender so you don't have to." },
        ].map((s) => (
          <li class="rounded-2xl border border-white/10 bg-white/5 p-6 flex flex-col h-full">
            <p class="font-script text-3xl text-mint-300">{s.n}</p>
            <p class="mt-2 text-lg font-semibold text-cream-50">{s.t}</p>
            <p class="mt-2 text-sm text-cream-100/75 leading-relaxed">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ ABOUT ============ -->
  <section id="about" class="section scroll-mt-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mint-700 font-semibold">About us</p>
      <h2 class="mt-3 text-4xl sm:text-5xl font-bold text-ink-900 leading-[1.05]">
        A small team.<br />
        <span class="font-script text-mint-700 font-normal text-5xl sm:text-6xl">A big heart.</span>
      </h2>
      <p class="mt-6 text-lg text-ink-700/80 leading-relaxed">
        The Little Mint Mortgage Company started with a simple idea: getting a mortgage should feel like a beginning, not a chore. Based in Fleetwood, we've stayed small on purpose — small enough to know every client by name, no matter where they are in the UK.
      </p>
      <p class="mt-4 text-lg text-ink-700/80 leading-relaxed">
        We search the whole of the market, recommend what we'd recommend to a friend, and stay on the line until the keys are in your hand.
      </p>
      <p class="mt-6 text-lg text-ink-800 font-medium leading-relaxed">
        When you call, you speak to Sarah. She'll have read your file, she won't put you on hold, and she'll remember your name next time.
      </p>
    </div>
  </section>

  <!-- ============ VALUES ============ -->
  <section class="section bg-mint-50/50">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="text-xs uppercase tracking-[0.3em] text-mint-700 font-semibold">What we believe</p>
        <h2 class="mt-3 text-4xl sm:text-5xl font-bold text-ink-900 leading-tight">
          Four things we won't <span class="font-script text-mint-700 font-normal text-5xl sm:text-6xl">compromise on.</span>
        </h2>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2">
        {values.map((v, i) => (
          <article class="relative rounded-2xl border border-mint-100 bg-white p-8 hover:shadow-mint-glow transition">
            <div class="flex items-center gap-3">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-mint-100 text-mint-700 font-bold">
                {String(i + 1).padStart(2, "0")}
              </span>
              <h3 class="text-2xl font-semibold text-ink-900">{v.title}</h3>
            </div>
            <p class="mt-4 text-ink-700/80 leading-relaxed">{v.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ STORY ============ -->
  <section class="section wash-mint">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="grid lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-7">
          <p class="text-xs uppercase tracking-[0.3em] text-mint-700 font-semibold">Our story</p>
          <h2 class="mt-3 text-4xl sm:text-5xl font-bold text-ink-900 leading-tight">
            One adviser, <span class="font-script text-mint-700 font-normal text-5xl sm:text-6xl">a long list of friends.</span>
          </h2>
          <div class="mt-8 space-y-5 text-lg text-ink-700/85 leading-relaxed max-w-2xl">
            <p>The Little Mint started the way most good businesses do — one adviser, a growing list of friends who all needed a mortgage at roughly the same time, and a stubborn refusal to be anything other than personal about it. Word spread. Friends-of-friends appeared. The list got longer.</p>
            <p>Years on, we're still small on purpose. We've resisted the temptation to scale into a call centre because the thing our clients tell us they value most is the thing we're worst at doing at scale: remembering their story.</p>
            <p>We help buyers across the whole of the UK and Sarah operates as an appointed representative of a principal firm authorised and regulated by the Financial Conduct Authority. We get paid by the lender, never by you, and we'll always tell you when <em>not</em> to borrow.</p>
          </div>
        </div>

        <div class="lg:col-span-5 flex items-center justify-center lg:justify-end">
          <div class="relative w-full max-w-xs sm:max-w-sm lg:max-w-md">
            <div class="absolute inset-4 rounded-[2.5rem] bg-gradient-to-br from-mint-200/60 via-mint-100/30 to-transparent blur-2xl"></div>
            <div class="relative rounded-[2.5rem] bg-white p-8 ring-1 ring-mint-200 shadow-mint-glow">
              <img
                src={logo.src}
                alt="The Little Mint Mortgage Company logo"
                width="384"
                height="384"
                class="relative h-auto w-full"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section id="faq" class="section scroll-mt-20">
    <div class="mx-auto max-w-3xl px-5 sm:px-8">
      <p class="text-xs uppercase tracking-[0.3em] text-mint-700 font-semibold">Frequently asked questions</p>
      <h2 class="mt-3 text-4xl sm:text-5xl font-bold text-ink-900 leading-tight">Common questions, <span class="font-script text-mint-700 font-normal text-5xl sm:text-6xl">answered plainly.</span></h2>
      <p class="mt-5 text-lg text-ink-700/80 leading-relaxed">If your question isn't here, just call — Sarah picks up.</p>

      <div class="mt-12 divide-y divide-mint-100 border-y border-mint-100">
        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">How much can I borrow?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">Most lenders offer 4 to 4.5 times your annual income, though some go higher and self-employed borrowers are usually assessed on 2 to 3 years of accounts. We'll run a quick affordability check during your first chat and give you a realistic figure rather than a headline number that falls apart at application stage.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">Do you charge a fee?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">No. We get paid by the lender when your mortgage completes, not by you. There's no upfront fee, no application fee, and no charge if your circumstances change and you don't proceed.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">Are you whole of market?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">Yes. We search the entire market — every lender we'd consider for your circumstances — rather than a small panel. We're not tied to any one lender and we'd tell you if a deal isn't right.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">How long does a remortgage take?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">Typically 4 to 6 weeks from agreement in principle to completion. We'll start the process 3 to 4 months before your existing deal ends so we have plenty of time to find the right product without rushing.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">Can I get a buy-to-let mortgage through a limited company?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">Yes — limited company buy-to-let is one of our regular asks. We'll compare special limited-company BTL rates against the personal route, look at tax efficiency for your situation, and explain the trade-offs in plain English before recommending anything.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">I'm self-employed — can I still get a mortgage?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">Almost always yes. Sole traders, limited company directors, freelancers, contractors and umbrella workers all borrow — but lenders look at you differently. We work with lenders who specialise in non-PAYE income and know what paperwork maximises your borrowing.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">How does Help to Buy work?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">Help to Buy is a government equity loan that tops up your deposit, so you only need a 5% deposit from you and the government lends you up to 20% (40% in London) interest-free for five years. We'll explain the rules, repayment triggers, and whether it suits your situation.</p>
        </details>

        <details class="group py-6">
          <summary class="flex items-start justify-between gap-4 cursor-pointer list-none">
            <h3 class="text-xl font-semibold text-ink-900">Where are your clients based?</h3>
            <svg class="mt-1 h-5 w-5 flex-none text-mint-700 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.06l3.71-3.83a.75.75 0 111.08 1.04l-4.25 4.39a.75.75 0 01-1.08 0L5.21 8.27a.75.75 0 01.02-1.06z" clip-rule="evenodd" /></svg>
          </summary>
          <p class="mt-4 text-ink-700/85 leading-relaxed">No. Based in Fleetwood, we help buyers across the whole of the UK — England, Wales, Scotland and Northern Ireland. Most of our conversations happen on the phone or video, and we can meet in person where it makes sense.</p>
        </details>
      </div>
    </div>
  </section>

