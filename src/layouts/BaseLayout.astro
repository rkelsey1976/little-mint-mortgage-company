---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import sarahWebp from "../assets/sarah.webp";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "The Little Mint Mortgage Company",
  description = "Independent, fee-free mortgage advice from Sarah — a whole-of-market mortgage adviser in Fleetwood, serving first-time buyers, remortgages, buy-to-let, self-employed, Help to Buy and equity release across the UK. Every home has a story.",
  pageClass = "",
} = Astro.props;

const siteName = "The Little Mint Mortgage Company";
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://thelittlemint.example.com");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={sarahWebp.src} as="image" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={new URL("/og-default.jpg", Astro.site ?? "https://thelittlemint.example.com")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Little Mint Mortgage Company — Mortgages, made human." />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-default.jpg", Astro.site ?? "https://thelittlemint.example.com")} />
    <meta name="twitter:image:alt" content="The Little Mint Mortgage Company — Mortgages, made human." />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#1f7d7d" />
    <!-- JSON-LD: Organization + FinancialService + Person + FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": ["Organization", "FinancialService"],
          "@id": "https://little-mint-mortgage.netlify.app/#organization",
          "name": "The Little Mint Mortgage Company",
          "alternateName": "The Little Mint",
          "url": "https://little-mint-mortgage.netlify.app/",
          "logo": {
            "@type": "ImageObject",
            "url": "https://little-mint-mortgage.netlify.app/og-default.jpg",
            "width": 1200,
            "height": 630
          },
          "image": "https://little-mint-mortgage.netlify.app/og-default.jpg",
          "description": "Independent, fee-free mortgage advice from Sarah — a whole-of-market mortgage adviser in Fleetwood, serving first-time buyers, remortgages, buy-to-let, self-employed, Help to Buy and equity release across the UK.",
          "slogan": "Every home has a story.",
          "email": "mailto:sarah@thelittlemintmortgagecompany.com",
          "telephone": "+44-7793-204066",
          "areaServed": [
            { "@type": "City", "name": "Fleetwood" },
            { "@type": "AdministrativeArea", "name": "Lancashire" },
            { "@type": "Country", "name": "United Kingdom" },
            { "@type": "AdministrativeArea", "name": "England" },
            { "@type": "AdministrativeArea", "name": "Wales" },
            { "@type": "AdministrativeArea", "name": "Scotland" },
            { "@type": "AdministrativeArea", "name": "Northern Ireland" }
          ],
          "serviceType": [
            "Mortgage broker",
            "Independent mortgage adviser",
            "Whole-of-market mortgage advice"
          ],
          "knowsAbout": [
            "First-time buyer mortgages",
            "Home mover mortgages",
            "Remortgaging",
            "Buy-to-let mortgages",
            "Portfolio buy-to-let",
            "Limited company buy-to-let",
            "Self-employed mortgages",
            "Help to Buy",
            "Shared Ownership",
            "Equity release",
            "Later-life lending",
            "Life cover",
            "Critical illness cover",
            "Income protection",
            "Buildings and contents insurance"
          ],
          "priceRange": "$$",
          "paymentAccepted": "No fee — paid by lender on completion",
          "openingHoursSpecification": [
            {
              "@type": "OpeningHoursSpecification",
              "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
              "opens": "09:00",
              "closes": "18:00"
            }
          ],
          "contactPoint": {
            "@type": "ContactPoint",
            "contactType": "Customer service",
            "telephone": "+44-7793-204066",
            "email": "sarah@thelittlemintmortgagecompany.com",
            "availableLanguage": "English",
            "hoursAvailable": "Mo-Fr 09:00-18:00",
            "areaServed": "GB"
          },
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Office 12, 13-15 Preston Street",
            "addressLocality": "Fleetwood",
            "addressRegion": "Lancashire",
            "postalCode": "FY7 6JA",
            "addressCountry": "GB"
          },
          "founder": { "@id": "https://little-mint-mortgage.netlify.app/#sarah" },
          "sameAs": [
            "https://www.facebook.com/profile.php?id=61591207851140"
          ]
        },
        {
          "@type": "Person",
          "@id": "https://little-mint-mortgage.netlify.app/#sarah",
          "name": "Sarah Mullender",
          "givenName": "Sarah",
          "familyName": "Mullender",
          "jobTitle": "Founder & mortgage adviser (CeMAP)",
          "hasCredential": {
            "@type": "EducationalOccupationalCredential",
            "name": "Certificate in Mortgage Advice and Practice",
            "credentialCategory": "certificate",
            "recognizedBy": {
              "@type": "Organization",
              "name": "Chartered Institute of Insurance / London Institute of Banking & Finance"
            }
          },
          "worksFor": { "@id": "https://little-mint-mortgage.netlify.app/#organization" },
          "knowsAbout": [
            "First-time buyer mortgages",
            "Home mover mortgages",
            "Remortgaging",
            "Single let buy-to-let",
            "Portfolio buy-to-let",
            "Limited company buy-to-let",
            "Self-employed mortgages",
            "Help to Buy and Shared Ownership",
            "Equity release",
            "Life cover",
            "Critical illness cover",
            "Income protection",
            "Buildings and contents insurance"
          ],
          "description": "CeMAP-qualified mortgage adviser specialising in residential mortgages — first-time buyer, home mover, remortgage, single buy-to-let, portfolio buy-to-let and limited company buy-to-let — plus protection insurance (life cover, critical illness, income protection, buildings and contents)."
        },
        {
          "@type": "FAQPage",
          "@id": "https://little-mint-mortgage.netlify.app/#faq",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "How much can I borrow?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Most lenders offer 4 to 4.5 times your annual income, though some go higher and self-employed borrowers are usually assessed on 2 to 3 years of accounts. We'll run a quick affordability check during your first chat and give you a realistic figure rather than a headline number that falls apart at application stage."
              }
            },
            {
              "@type": "Question",
              "name": "Do you charge a fee?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "No. We get paid by the lender when your mortgage completes, not by you. There's no upfront fee, no application fee, and no charge if your circumstances change and you don't proceed."
              }
            },
            {
              "@type": "Question",
              "name": "Are you whole of market?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes. We search the entire market — every lender we'd consider for your circumstances — rather than a small panel. We're not tied to any one lender and we'd tell you if a deal isn't right."
              }
            },
            {
              "@type": "Question",
              "name": "How long does a remortgage take?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Typically 4 to 6 weeks from agreement in principle to completion. We'll start the process 3 to 4 months before your existing deal ends so we have plenty of time to find the right product without rushing."
              }
            },
            {
              "@type": "Question",
              "name": "Can I get a buy-to-let mortgage through a limited company?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Yes — limited company buy-to-let is one of our regular asks. We'll compare special limited-company BTL rates against the personal route, look at tax efficiency for your situation, and explain the trade-offs in plain English before recommending anything."
              }
            },
            {
              "@type": "Question",
              "name": "I'm self-employed — can I still get a mortgage?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Almost always yes. Sole traders, limited company directors, freelancers, contractors and umbrella workers all borrow — but lenders look at you differently. We work with lenders who specialise in non-PAYE income and know what paperwork maximises your borrowing."
              }
            },
            {
              "@type": "Question",
              "name": "How does Help to Buy work?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "Help to Buy is a government equity loan that tops up your deposit, so you only need a 5% deposit from you and the government lends you up to 20% (40% in London) interest-free for five years. We'll explain the rules, repayment triggers, and whether it suits your situation."
              }
            },
            {
              "@type": "Question",
              "name": "Where are your clients based?",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "We help buyers across the whole of the UK — England, Wales, Scotland and Northern Ireland. Most of our conversations happen on the phone or video, and we can meet in person where it makes sense."
              }
            }
          ]
        }
      ]
    })} />
  </head>
  <body class={pageClass}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-mint-700 focus:text-white focus:px-4 focus:py-2 focus:rounded">
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
  </body>
</html>
